# Required for live FRED/ALFRED collection.
FRED_API_KEY=

# Required for live NASA Earthdata/VIIRS collection.
EARTHDATA_TOKEN=

# Optional: only needed if PR0 selects GDELT through BigQuery.
# BigQuery uses Application Default Credentials, not an API key.
GOOGLE_CLOUD_PROJECT=
GOOGLE_APPLICATION_CREDENTIALS=

# Local Ollama configuration; no token is required.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3.8:27b-mlx
