# Credentials and source locators. Copy to `.env` and fill what you have.
# `wsd doctor` reports presence only; it never prints values.

# Desk runtime. `docker compose up` overrides this to postgresql://wsd:wsd@db:5432/wsd.
# Host-run API/UI can omit it; /api/health then reports db.configured=false.
DATABASE_URL=postgresql://wsd:wsd@127.0.0.1:5432/wsd

# ---------------------------------------------------------------------------
# Sources that need a credential
# ---------------------------------------------------------------------------

# FRED/ALFRED (dyad.fx) and Brent (info.brent, out of v1 basket).
# Free key: https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=

# NASA Earthdata / VIIRS VNP46A2 Collection 2 (tempo.viirs_aoi).
# Register: https://urs.earthdata.nasa.gov/users/new
# Also run: uv sync --extra viirs
EARTHDATA_TOKEN=

# NASA FIRMS MAP_KEY (tempo.firms_thermal). Free.
# https://firms.modaps.eosdis.nasa.gov/api/
# Quota: 5000 transactions per 10 minutes. Area API = 1 transaction per call,
# max 10 days. A 21-day window is 3 calls; ukraine2022 incident+control is 6.
# Default sensor is VIIRS_NOAA20_SP (Apr 2018–present). Suomi-NPP delivery
# ceases 1 Nov 2026: https://www.earthdata.nasa.gov/data/alerts-outages/suomi-npp-data-product-delivery-cease-november-1-2026
FIRMS_MAP_KEY=
FIRMS_SENSOR=VIIRS_NOAA20_SP

# Copernicus Data Space OAuth client (tempo.s1_backscatter Statistical API).
# Register, then User settings -> OAuth clients:
# https://dataspace.copernicus.eu/
COPERNICUS_CLIENT_ID=
COPERNICUS_CLIENT_SECRET=

# OpenSky Trino historical ADS-B (mobility.opensky, uninstantiated until access).
# 1. Create an account with a KCL email: https://opensky-network.org/
# 2. Request Trino access: https://opensky-network.org/data/trino
# 3. Docs: https://openskynetwork.github.io/opensky-api/trino.html
# Username is the website login (lowercase). Do not scrape the public REST API.
OPENSKY_TRINO_USER=
OPENSKY_TRINO_PASSWORD=

# Optional: only if GDELT is later selected through BigQuery.
# Bulk GDELT needs no key (see below). BigQuery uses ADC, not an API key.
GOOGLE_CLOUD_PROJECT=
GOOGLE_APPLICATION_CREDENTIALS=

# Host CLI -> Docker desk API. packet draft submits work here, not to Ollama.
WSD_API_BASE_URL=http://127.0.0.1:8000
WSD_API_TIMEOUT_SECONDS=1800

# Docker API -> local Ollama for working-assessment drafts; no key is required.
# The frozen intent_triage_v0 experiment remains separate and disabled.
# Inside Docker, use a host-reachable base URL (e.g. http://host.docker.internal:11434).
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=qwen3.8:27b-mlx
OLLAMA_TIMEOUT_SECONDS=900
OLLAMA_MAX_OUTPUT_TOKENS=4096
OLLAMA_NUM_CTX=32768

# ---------------------------------------------------------------------------
# Sources with no API key. Leave the path/placeholder as-is unless you move files.
# ---------------------------------------------------------------------------

# Wikipedia pageviews (attn.wiki_pageviews). No credential.
# https://wikimedia.org/api/rest_v1/
# Docs: https://doc.wikimedia.org/generated-data-platform/aqs/analytics-api/
WIKIMEDIA_PAGEVIEWS=public

# Wikipedia revisions (attn.wiki_edits; out of v1 basket). No credential.
# https://www.mediawiki.org/wiki/API:Revisions
# https://en.wikipedia.org/w/api.php
WIKIMEDIA_ACTION_API=public

# GDELT Events 2.0 English export (talk.gdelt_cameo). No credential.
# Project: https://www.gdeltproject.org/
# Bulk files: http://data.gdeltproject.org/gdeltv2/
GDELT_V2_EXPORT=public

# MOEX ISS USD/RUB (dyad.moex_usdrub). No credential.
# https://www.moex.com/en/iss
# https://iss.moex.com/iss/reference/
MOEX_ISS=public

# OpenStreetMap changeset API (attn.osm_changesets; out of v1 basket). No credential.
# https://wiki.openstreetmap.org/wiki/API_v0.6
# https://api.openstreetmap.org/api/0.6/changesets
OSM_API=public

# RIPEstat announced prefixes (net.ripe_prefixes). No credential.
# https://stat.ripe.net/
# https://stat.ripe.net/docs/02.data-api/announced-prefixes.html
RIPESTAT=public

# Internet Archive CDX (official.gazette). No credential.
# https://web.archive.org/
# https://archive.org/developers/wayback-cdx-server.html
INTERNET_ARCHIVE_CDX=public

# Certificate Transparency via crt.sh (official.ct_certs). No credential.
# https://crt.sh/
CRTSH=public

# ICEWS coded events (talk.icews_cameo). No API key.
# Point this at the 1.6GB Dataverse zip, an unpacked directory of yearly .tab
# files, or a single .tab/.csv. The connector reads the archive in place and
# only opens members whose year overlaps the scenario window.
# Dataset: https://dataverse.harvard.edu/dataset.xhtml?persistentId=doi:10.7910/DVN/28075
ICEWS_EVENTS_PATH=data/raw/icews/dataverse_files.zip

# Tavily search for packet-scoped open-source harvest (does not vote).
# Replay requests the lookback window through the packet cutoff. Date filtering
# still admits undated official hits as unverified; see ROADMAP phase 5a.
# REST uses TAVILY_API_KEY; the MCP URL is for other clients.
# https://docs.tavily.com
TAVILY_API_KEY=
TAVILY_MCP=https://mcp.tavily.com/mcp/?tavilyApiKey=
